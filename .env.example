# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL control plane
POSTGRES_DB=sentrix
POSTGRES_USER=sentrix
POSTGRES_PASSWORD=sentrix-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# ClickHouse telemetry store
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=sentrix
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Frontend
VITE_API_BASE_URL=/api/v1
